# Шаблон единственного источника настроек деплоя. Скопируйте в .env и заполните.
#
# Всё, что объявлено в .env, имеет приоритет над таблицей config в SQLite:
# строка, сохранённая через Админ → Настройки, перекрывается этим файлом.
# Уберите имя из файла, чтобы вернуть настройку в ведение админки.
#
# Значения по умолчанию, зашитые в Dockerfile и docker-compose, не должны
# дублировать то, что объявлено здесь.
#
# PORT, HOST, FORWARDED_ALLOW_IPS и WEBUI_SECRET_KEY нужны до импорта приложения,
# их читает backend/start.sh — и он же разбирает этот файл (тем же парсером, что
# и env.py), так что дублировать их в окружении контейнера не нужно.
# Осторожно с WEBUI_SECRET_KEY: объявленный здесь он перекрывает уже
# сгенерированный /app/backend/.webui_secret_key (проверено на start.sh), то есть
# перезапуск разлогинит все активные сессии. Не пишите его, если не собираетесь
# намеренно повернуть ключ.



# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
# Для контейнера localhost — это сам контейнер; Ollama на хосте доступна по
# http://host.docker.internal:11434
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ── Встраивание документов ───────────────────────────────────────────────────
# Перечислять ENGINE/MODEL здесь стоит только при фиксированном деплое:
# объявленное имя перестаёт управляться из Админ → Настройки.
# BATCH_SIZE=1 и параллельность 1 — безопасный режим для CPU-эмбеддингов;
# большие значения затапливают сервер (503 "server busy", обрывы соединения).
# RAG_EMBEDDING_ENGINE='ollama'
# RAG_EMBEDDING_MODEL='qwen3-embedding:0.6b'
RAG_EMBEDDING_BATCH_SIZE=1
RAG_EMBEDDING_CONCURRENT_REQUESTS=1
# Интервал без признаков прогресса, после которого загрузка считается зависшей.
RAG_EMBEDDING_IDLE_TIMEOUT=7200
# Дедлайн одного HTTP-запроса к эмбеддинг-серверу.
RAG_EMBEDDING_REQUEST_TIMEOUT=3600
# Сколько секунд Ollama держит модель в памяти между запросами. Без этого сервер
# выгружает веса через 5 минут простоя, и каждый запрос после паузы платит полную
# цену загрузки модели. Число — секунды; строку без юнита ("7200") Ollama отвергает
# с 400 "missing unit in duration".
RAG_EMBEDDING_KEEP_ALIVE=7200
# Префиксы обязательны для семейства e5 (у запроса и у документа разные) и бесполезны
# для остальных моделей. Ключей в таблице config нет — читаются напрямую из окружения.
# Значение с завершающим пробелом, кавычки его сохраняют.
# RAG_EMBEDDING_QUERY_PREFIX='query: '
# RAG_EMBEDDING_CONTENT_PREFIX='passage: '

# ── Нарезка на чанки ─────────────────────────────────────────────────────────
# chunk_size считается в токенах, но в каких именно — зависит от TEXT_SPLITTER:
# 'token' считает cl100k_base (дефолт), 'token_transformers' — токенизатором самой
# модели из RAG_TOKENIZER_MODEL. Второе корректно, когда у модели жёсткое окно: у
# multilingual-e5 это 512 её собственных токенов, а cl100k-чанк в 1000 токенов
# превращается в ~1300 — Ollama молча обрезает хвост (truncate=true, без ошибки).
# Пример под e5-large (460 подтверждён экспериментом hit@5 на реальных корпусах;
# overlap — 10% от размера):
# RAG_TEXT_SPLITTER='token_transformers'
# RAG_TOKENIZER_MODEL='intfloat/multilingual-e5-large'
# RAG_CHUNK_SIZE=460
# RAG_CHUNK_OVERLAP=46

# RAG_RERANKING_ENGINE='external'
# RAG_RERANKING_MODEL='qllama/bge-reranker-v2-m3:latest'

# Valkey Vector Store (requires VECTOR_DB=valkey)
# Valkey требует поднятого сервера: объявить VECTOR_DB=valkey без него
# означает остановку индексации.
# VECTOR_DB='chroma'
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'

# Шум библиотек
# TRANSFORMERS_NO_ADVISORY_WARNINGS=1
# TOKENIZERS_PARALLELISM=false
